# Security-sensitive: the secret scanner IS the primary leak gate, and CI runs
# it from the PR head — a change here can weaken the gate that reviews it. The
# hashed denylist must not shrink without an explicit, reviewed reason (CI also
# checks for removed entries vs origin/main). Require owner review on all three.
/scripts/secret-scan.mjs        @philbert440
/scripts/secret-denylist.json   @philbert440
/scripts/privacy-scan.mjs       @philbert440
/scripts/privacy-denylist.json  @philbert440
/scripts/privacy-denylist-add.mjs @philbert440
# Authorship: CI runs the checker from the PR head, and the checker loads
# authorship-allowlist.json from that same checkout. A one-line email add
# would otherwise pass Commit Authorship with no owner review.
/scripts/authorship-check.mjs          @philbert440
/scripts/authorship-allowlist.json     @philbert440
/scripts/sync-authorship-allowlist.mjs @philbert440
/scripts/git-hooks/             @philbert440
/.github/workflows/pipeline.yml @philbert440
/.github/CODEOWNERS             @philbert440
