# RivetOS Environment — copy to .env and fill in your values.
# Generated values: rivetos init creates this automatically.
# DO NOT commit the actual .env file.

# ─── AI Provider Keys ────────────────────────────────────────────────────────
# Set the ones you need based on your configured agents.

ANTHROPIC_API_KEY=sk-ant-...
# XAI_API_KEY=xai-...
# GOOGLE_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# OPENAI_COMPAT_API_KEY=sk-no-key-required   # vLLM / TGI / local OpenAI-compat servers
# pi-cli recommended backend is z.ai GLM (Anthropic-compat); reuse ANTHROPIC_API_KEY / coding-plan.
# No dedicated PI_* env var.
# QWEN_BINARY overrides the qwen binary (provider + setup). QWEN_HOME is RivetOS's lookup for ~/.qwen (plugins install, doctor); it does not relocate qwen's data dir.

# ─── Memory workers (only needed when embedding/compaction workers are enabled)

# Embedding worker (services/embedding-worker) — required when that unit is on.
# RIVETOS_EMBED_URL=                      # no default; worker exits without it
# RIVETOS_EMBED_MODEL=nemotron            # default if unset: nemotron

# Compaction worker (services/compaction-worker) — required when that unit is on.
# RIVETOS_COMPACTOR_URL=                  # no default; worker exits without it
# RIVETOS_COMPACTOR_MODEL=rivet-refined-v5 # default if unset: rivet-refined-v5

# ─── Database ─────────────────────────────────────────────────────────────────

POSTGRES_USER=rivetos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rivetos

# Connection string used by agents (datahub = docker service name).
# Required by infra/docker/rivetos/docker-compose.yml together with POSTGRES_PASSWORD.
RIVETOS_PG_URL=postgresql://rivetos:changeme@datahub:5432/rivetos

# ─── Optional ─────────────────────────────────────────────────────────────────

# Container registry (for rivetos build --push)
# RIVETOS_REGISTRY=ghcr.io/your-username

# Postgres host publish is 127.0.0.1:5433 → container 5432 in
# infra/docker/rivetos/docker-compose.yml. POSTGRES_PORT is not read.
# Health listener defaults to 127.0.0.1:3100 (RIVETOS_HEALTH_HOST / RIVETOS_HEALTH_PORT).
