# ---------------------------------------------------------------------------

@test "banner and unit file use rivetos-agent.service not rivetos.service" {
  bash "${NODE_SH}" --yes --hub owner@192.0.2.10 --name node-a --advertise-host 192.0.2.11 \
    >"${TEST_TMP}/unit.out" 2>"${TEST_TMP}/unit.err"
  [ -f "${RIVETHUB_SYSTEMD_DIR}/rivetos-agent.service" ]
  [ ! -f "${RIVETHUB_SYSTEMD_DIR}/rivetos.service" ]
  grep -q "rivetos-agent.service" "${TEST_TMP}/unit.out"
  grep -q "not rivetos.service" "${TEST_TMP}/unit.out"
  grep -q "^SyslogIdentifier=rivetos-agent$" "${RIVETHUB_SYSTEMD_DIR}/rivetos-agent.service"
}

