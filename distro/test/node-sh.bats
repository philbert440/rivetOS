# e2e F7 — rivet ssh keypair + hubside install
# ---------------------------------------------------------------------------

@test "node_main generates a rivet ssh keypair and records it in node.env" {
  bash "${NODE_SH}" --yes --hub owner@192.0.2.10 --name node-a --advertise-host 192.0.2.11 \
    >/dev/null 2>"${TEST_TMP}/k.err"
  [ -f "${RIVETOS_HOME}/.ssh/id_ed25519" ]
  [ -f "${RIVETOS_HOME}/.ssh/id_ed25519.pub" ]
  [ "$(stat -c %a "${RIVETOS_HOME}/.ssh/id_ed25519")" = "600" ]
  grep -q "^RIVET_SSH_KEY=${RIVETOS_HOME}/.ssh/id_ed25519$" "${RIVETHUB_ROOT}/node.env"
  grep -q "^HUB_TARGET=owner@192.0.2.10$" "${RIVETHUB_ROOT}/node.env"
  grep -q "rivet ssh key" "${TEST_TMP}/k.err"
}

@test "ensure_rivet_ssh_key is idempotent" {
  bash -c '
    source "$1"
    init_paths
    ensure_rivet_ssh_key
    cp "$RIVET_HOME/.ssh/id_ed25519.pub" "$TEST_TMP/pub1"
    ensure_rivet_ssh_key
    cmp -s "$RIVET_HOME/.ssh/id_ed25519.pub" "$TEST_TMP/pub1"
  ' bash "${NODE_SH}"
}

@test "install_rivet_key_on_hub copies the pubkey over BatchMode ssh" {
  install_ssh_stub
  bash -c '
    source "$1"
    init_paths
    ensure_rivet_ssh_key
  ' bash "${NODE_SH}"
  run env RIVETHUB_TEST_SSH_KEY=1 bash -c '
    source "$1"
    init_paths
    install_rivet_key_on_hub owner@192.0.2.10
  ' bash "${NODE_SH}"
  [ "${status}" -eq 0 ]
  [[ "${output}" == *"installed rivet pubkey"* ]]
  grep -q "BatchMode=yes" "${TEST_TMP}/ssh.log"
  [ -s "${TEST_TMP}/hub-authorized-keys" ]
  grep -q "ssh-ed25519" "${TEST_TMP}/hub-authorized-keys"
}

@test "banner documents day-2 mesh sync/renew as rivet" {
  run bash -c '
    source "$1"
    init_paths
    FLAG_DOCKER=0
    NODE_NAME=node-a
    RIVET_UID=2000
    HUB_TARGET=owner@192.0.2.10
    print_banner
  ' bash "${NODE_SH}"
  [ "${status}" -eq 0 ]
  [[ "${output}" == *"sudo -u rivet -H rivetos mesh sync"* ]]
  [[ "${output}" == *"sudo -u rivet -H rivetos mesh renew"* ]]
  [[ "${output}" == *"id_ed25519"* ]]
}
