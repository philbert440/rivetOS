{
  "name": "@rivetos/grok-bot-rivet-memory-capture",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Grok Bot transcript normalizer on @rivetos/capture-core. Strips wrapper noise, stamps real message times, tags each bot, and emits CaptureMessage rows.",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "grokbot-rivet-memory-capture": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "eslint src/ package.json"
  },
  "dependencies": {
    "@rivetos/capture-core": "0.5.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "nx": {
    "tags": [
      "scope:adapter",
      "type:plugin",
      "domain:memory"
    ]
  }
}
