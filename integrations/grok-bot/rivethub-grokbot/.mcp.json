{
  "mcpServers": {
    "rivetos-memory": {
      "command": "${CURSOR_PLUGIN_ROOT}/bin/rivetos-memory-mcp.sh",
      "env": {
        "RIVETOS_MCP_ENABLE_MEMORY_WRITE": "1",
        "RIVETOS_MEMORY_SOURCE": "grokbot",
        "RIVETOS_MEMORY_CHANNEL": "grokbot",
        "RIVETOS_MODE": "${RIVETOS_MODE}",
        "RIVETOS_CLOUD_TOKEN": "${RIVETOS_CLOUD_TOKEN}",
        "RIVETOS_CLOUD_URL": "${RIVETOS_CLOUD_URL}",
        "RIVETOS_DATAHUB_URL": "${RIVETOS_DATAHUB_URL}",
        "RIVETOS_PG_URL": "${RIVETOS_PG_URL}"
      }
    }
  }
}
