{
  "_comment": "Example only — enable when Grok Bot loads plugin hooks like Grok Build / Claude Code.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CURSOR_PLUGIN_ROOT}/../rivet-memory/bin/rivet-memory-hook.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
