{
  "name": "@rivetos/grok-rivet-memory-capture",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Capture worker for the Grok Build rivet-memory integration. Spools hook payloads and writes them into the shared RivetOS memory store under agent='rivet-grok'.",
  "license": "Apache-2.0",
  "main": "dist/grok-memory-capture.js",
  "bin": {
    "grok-rivet-memory-capture": "dist/grok-memory-capture.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx test/smoke.test.ts && vitest run",
    "clean": "rm -rf dist",
    "lint": "eslint src/ package.json"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "@rivetos/capture-core": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3"
  },
  "nx": {
    "tags": [
      "scope:adapter",
      "type:plugin",
      "domain:memory"
    ]
  }
}
