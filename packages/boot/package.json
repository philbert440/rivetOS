{
  "name": "@rivetos/boot",
  "version": "0.5.0",
  "description": "RivetOS composition root \u2014 config loading, plugin wiring, lifecycle",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ package.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rivetos/types": "0.5.0",
    "@rivetos/core": "0.5.0",
    "@rivetos/workflows": "0.5.0",
    "@rivetos/provider-claude-cli": "0.5.0",
    "@rivetos/harness-kimi-code": "0.5.0",
    "pg": "^8.22.0",
    "undici": "^8.10.0",
    "yaml": "^2.9.0",
    "@rivetos/den-server": "0.5.0",
    "@rivetos/memory-postgres": "0.5.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbert440/rivetOS.git",
    "directory": "packages/boot"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "tags": [
      "scope:composition",
      "type:lib"
    ]
  }
}
