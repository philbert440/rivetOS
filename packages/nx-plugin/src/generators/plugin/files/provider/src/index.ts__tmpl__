/**
 * <%= packageName %>
 *
 * <%= description %>
 */

import type { Provider, PluginManifest } from '@rivetos/types'
import type { ProviderAiSdkBridge } from '@rivetos/aisdk'
import type { LanguageModel } from 'ai'
import { createOpenAICompatible } from '@ai-sdk/openai-compatible'

// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------

export interface <%= className %>Config {
  apiKey: string
  model?: string
  baseUrl?: string
  maxTokens?: number
}

// ---------------------------------------------------------------------------
// Provider
// ---------------------------------------------------------------------------

export class <%= className %> implements Provider {
  id: string
  name = '<%= name %>'

  private config: <%= className %>Config
  private model: string

  constructor(id: string, config: <%= className %>Config) {
    this.id = id
    this.config = config
    this.model = config.model ?? 'default-model' // TODO: real default model id
  }

  /**
   * AI SDK bridge — the agent loop drives this provider via `streamText`.
   * The OpenAI-compatible adapter covers most APIs; swap in a dedicated
   * `@ai-sdk/*` package (see plugins/providers/anthropic) when one exists.
   */
  aiSdkBridge(): ProviderAiSdkBridge {
    return {
      getModel: ({ modelOverride }): LanguageModel => {
        const provider = createOpenAICompatible({
          baseURL: this.config.baseUrl ?? 'https://api.example.invalid/v1', // TODO: real base URL
          name: this.name,
          apiKey: this.config.apiKey || undefined,
          includeUsage: true,
        })
        return provider.chatModel(modelOverride ?? this.model)
      },
    }
  }

  async isAvailable(): Promise<boolean> {
    // TODO: Check if the API key is valid / service is reachable
    return Boolean(this.config.apiKey)
  }

  getModel(): string {
    return this.model
  }

  setModel(model: string): void {
    this.model = model
  }

  getContextWindow(): number {
    return 0 // TODO: tokens (0 = unknown/unlimited)
  }

  getMaxOutputTokens(): number {
    return this.config.maxTokens ?? 0
  }
}

// ---------------------------------------------------------------------------
// Plugin manifest
// ---------------------------------------------------------------------------

export const manifest: PluginManifest = {
  type: 'provider',
  name: '<%= name %>',
  register(ctx) {
    const cfg = ctx.pluginConfig ?? {}
    ctx.registerProvider(
      new <%= className %>('<%= name %>', {
        apiKey: (cfg.api_key as string | undefined) ?? '',
        model: cfg.model as string | undefined,
        baseUrl: cfg.base_url as string | undefined,
        maxTokens: cfg.max_tokens as number | undefined,
      }),
    )
  },
}
