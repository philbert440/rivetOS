{
  "name": "@rivetos/mcp-sidecar",
  "version": "0.5.0",
  "description": "Standalone RivetOS MCP server — stdio, TCP, or unix socket",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rivetos-mcp-sidecar": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ package.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rivetos/mcp": "0.5.0",
    "@rivetos/mcp-v2": "0.5.0",
    "@rivetos/memory-postgres": "0.5.0",
    "@rivetos/types": "0.5.0",
    "@rivetos/tool-file": "0.5.0",
    "@rivetos/tool-search": "0.5.0",
    "@rivetos/tool-shell": "0.5.0",
    "@rivetos/tool-web-search": "0.5.0",
    "zod": "^4.4.3",
    "@rivetos/agent-registry": "0.5.0",
    "@rivetos/core": "0.5.0",
    "@rivetos/wiki-core": "0.5.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbert440/rivetOS.git",
    "directory": "services/mcp-sidecar"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "tags": [
      "scope:app",
      "type:app"
    ]
  }
}
