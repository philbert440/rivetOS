{
  "name": "@rivetos/embedding-worker",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Embedding worker — graphile-worker task that embeds rows from ros_messages/ros_summaries via Nemotron",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
