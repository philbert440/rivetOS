{
  "provider": "llama-server",
  "scenario": "A-text",
  "description": "Plain text answer with usage (incl. cached input tokens where the wire has them).",
  "instantiation": "manifest.register(ctx) with the config slice (base_url honoured).",
  "pluginConfig": {
    "model": "test-model",
    "api_key": "<redacted>",
    "base_url": "http://127.0.0.1:47815"
  },
  "baseUrlOverride": null,
  "registrationLog": [],
  "agent": {
    "id": "test-agent",
    "provider": "llama-server",
    "default_thinking": "medium"
  },
  "loop": {
    "systemPrompt": "You are a test.",
    "thinking": "medium",
    "modelOverride": null,
    "agentId": "test-agent",
    "sessionId": "test-session",
    "userId": null,
    "hooks": "new HookPipelineImpl() (no hooks registered)",
    "maxSteps": "default (stepCountIs(50))",
    "turnTimeout": "default (1800000 ms)",
    "contextWindow": 0
  },
  "userMessage": "Say hi.",
  "history": [],
  "tools": [
    {
      "name": "echo",
      "description": "Echo the arguments back as JSON.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to echo back."
          },
          "n": {
            "type": "number",
            "description": "A number to echo back."
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "fakeServer": "http://127.0.0.1:47815"
}
