<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices below API 31 (API 31+ uses
   data_extraction_rules.xml).

   The include list already limits the backup set to `upload/`, but the bearer
   prefs file is excluded explicitly so widening that list later cannot start
   syncing node credentials off the device by accident. See
   dev.rivet.app.data.node.SharedPrefsNodeTokenStore.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
  <include
    domain="file"
    path="upload/" />
  <exclude
    domain="sharedpref"
    path="rivet_node_tokens.xml" />
  <!-- Device client PKCS#12 + encrypted passphrase vault for gateway mTLS. -->
  <exclude
    domain="file"
    path="device.p12" />
  <exclude
    domain="sharedpref"
    path="rivet_device_identity.xml" />
  <exclude
    domain="sharedpref"
    path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
  <exclude
    domain="sharedpref"
    path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
</full-backup-content>
