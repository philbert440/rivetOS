<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+).

   Per-node gateway bearers live in their own prefs file so they can be excluded
   here: a credential the operator pasted into this phone should not ride a cloud
   backup or a device transfer to another handset. See
   dev.rivet.app.data.node.SharedPrefsNodeTokenStore.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude
      domain="sharedpref"
      path="rivet_node_tokens.xml" />
    <exclude
      domain="file"
      path="device.p12" />
    <exclude
      domain="sharedpref"
      path="rivet_device_identity.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude
      domain="sharedpref"
      path="rivet_node_tokens.xml" />
    <exclude
      domain="file"
      path="device.p12" />
    <exclude
      domain="sharedpref"
      path="rivet_device_identity.xml" />
  </device-transfer>
</data-extraction-rules>
