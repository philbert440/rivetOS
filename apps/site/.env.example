# Marketing-site pageviews for rivetos.dev (PostHog). The project API key is
# public by design — it is baked into the static HTML — but do not commit a
# live value. Leave unset to keep analytics off (local preview, CI without
# secrets).
#
# One PostHog project can be reused for rivetos.dev and rivethub.io; the
# hostname on each $pageview distinguishes the sites. Use a different key
# when building each site only if you want separate projects.
#
# GitHub: repository secrets PUBLIC_POSTHOG_KEY and optional
# PUBLIC_POSTHOG_HOST. House fallbacks NEXT_PUBLIC_POSTHOG_KEY and
# NEXT_PUBLIC_POSTHOG_HOST are also injected. pipeline.yml maps all four
# into the CI Build job. Production deploys that build this site outside
# that job must pass the same variables at build time (Astro inlines
# PUBLIC_*).

PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# House Next.js names are accepted as fallbacks if those secrets already exist:
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
