  /* 02 memory scrolly */
  .scrolly { margin-top: clamp(36px, 5vw, 64px); display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 64px); }
  .steps { list-style: none; padding: 0; }
