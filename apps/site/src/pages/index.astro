---
// rivetos.dev landing: custom page (docs stay Starlight). Scroll story that
// follows the architecture: clients → node → harnesses → memory, then the mesh,
// the plugin tree, and where to read next. Brand system: emerald on
// a blueprint grid, DM Sans + JetBrains Mono. Assets self-hosted except Google Fonts.
import robot from '../assets/robot.png'
import PostHog from '../components/PostHog.astro'
const GH = 'https://github.com/philbert440/rivetOS'
const HUB = 'https://rivethub.io/'
const CLOUD = 'https://rivetos.cloud/'
const harnesses = ['claude-code', 'codex', 'grok-build', 'kimi-code', 'hermes']
const inSource = ['opencode', 'pi', 'qwen-code']
const plugins = [
  { dir: 'providers', items: ['anthropic', 'xai', 'google', 'ollama', 'vllm', 'llama-server', 'claude-cli', 'codex-cli', 'grok-cli', 'hermes-cli', 'kimi-code', 'opencode-cli', 'pi-cli', 'qwen-code'] },
  { dir: 'tools', items: ['shell', 'file', 'search', 'web-search', 'mcp-client', 'interaction'] },
  { dir: 'memory', items: ['postgres'] },
  { dir: 'transports', items: ['mcp-server'] },
  { dir: 'channels', items: ['agent'] },
]
const guides = [
  { href: '/guides/getting-started/', title: 'Quick Start', text: 'Get RivetOS running in under five minutes.' },
  { href: '/guides/cloud/', title: 'Rivet Cloud', text: 'Connect a laptop to hosted memory; export and import dumps.' },
  { href: '/reference/architecture/', title: 'Architecture', text: 'RivetOS as a harness-first, per-node control plane.' },
  { href: '/reference/memory-design/', title: 'Memory System', text: 'Capture, compaction, and retrieval design.' },
  { href: '/guides/mesh/', title: 'Mesh Networking', text: 'Multi-node mesh with mTLS delegation.' },
  { href: '/guides/providers/', title: 'Provider Setup', text: 'API and local providers, plus harness CLIs.' },
  { href: '/guides/plugins/', title: 'Plugin Development', text: 'Write providers, tools, memory backends, transports.' },
  { href: '/guides/deployment/', title: 'Deployment', text: 'Docker, Proxmox, or bare metal.' },
  { href: '/reference/config/', title: 'Configuration', text: 'Every option, in one reference.' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>RivetOS: run your own agents, own the memory they share</title>
    <meta
      name="description"
      content="A personal AI agent runtime and memory plane you self-host. RivetHub is the install. Same repo: philbert440/rivetOS."
    />
    <meta property="og:title" content="RivetOS" />
    <meta property="og:description" content="Run your own agents. Own the memory they share." />
    <meta property="og:image" content="https://rivetos.dev/og.png" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Follow the docs' Starlight theme choice when there is one.
      try {
        var t = localStorage.getItem('starlight-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <PostHog />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="/">
          <img src={robot.src} alt="" width="26" height="30" />
          <span>RivetOS</span>
        </a>
        <nav class="top-nav" aria-label="Main">
          <a href="#runtime">Runtime</a>
          <a href="#memory">Memory</a>
          <a href="#mesh">Mesh</a>
          <a href="/guides/getting-started/">Docs</a>
          <a href={GH}>GitHub</a>
          <a class="top-cta" href={HUB} data-ph-event="cta_setup_agent">Get RivetHub</a>
        </nav>
      </div>
      <div class="progress" aria-hidden="true"><i></i></div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker"><span class="live" aria-hidden="true"></span>Apache 2.0 · no CLA · no Rivet account</p>
            <h1 id="hero-title">Run your own agents.<br /><em>Own the memory they share.</em></h1>
            <p class="lede">
              RivetOS is a personal AI agent runtime and memory plane you run yourself — not a hosted
              SaaS black box. The harnesses you already use keep their coding loop; RivetOS gives them
              one identity, one record, and one gateway, on machines you control.
            </p>
            <div class="term install">
              <pre tabindex="0" data-copy="curl -fsSL https://get.rivethub.io/local.sh | bash"><code><span class="ps">$ </span>curl -fsSL https://get.rivethub.io/local.sh | bash</code></pre>
            </div>
            <div class="ctas">
              <a class="btn primary" href={HUB} data-ph-event="cta_setup_agent">Get RivetHub</a>
              <a class="btn" href="/guides/getting-started/">Read the docs</a>
              <a class="btn ghost" href={GH}>GitHub</a>
            </div>
            <p class="fine">
              One product, one repo: <a href={GH}>philbert440/rivetOS</a>. RivetHub is the install; these
              docs are the deep reference. From a source checkout: <code>npx rivetos local</code>.
            </p>
          </div>
          <figure class="hero-viz">
            <canvas id="node-canvas" width="640" height="560" aria-hidden="true"></canvas>
            <div class="readout" aria-hidden="true">
              <span><b data-n="turns">0</b> turns</span>
              <span><b data-n="captured">0</b> captured</span>
              <span><b data-n="recalled">0</b> recalled</span>
            </div>
            <figcaption>
              One node, live. Clients send turns through the gateway to a harness; every turn is
              captured to memory (green); recalls flow back to whichever harness asks (brass).
            </figcaption>
          </figure>
        </div>
      </section>

      <div class="story">
        <div class="spine" aria-hidden="true"><i></i></div>

        <section class="chapter" id="runtime" aria-labelledby="runtime-title">
          <div class="wrap">
            <header class="chapter-head">
              <span class="stud" aria-hidden="true"></span>
              <p class="chapter-no">01 · The runtime</p>
              <h2 id="runtime-title">The harness owns the loop. RivetOS owns everything around it.</h2>
              <p class="chapter-lede">
                RivetOS doesn't compete with your coding tools. It adapts them through per-harness drivers
                and takes on the parts no single tool does well on its own.
              </p>
            </header>
            <div class="owns">
              <div class="owns-col">
                <p class="owns-label">Harness</p>
                <p class="owns-what">Coding loop: tools, model turns, approvals inside the TUI, interrupt, its native session store.</p>
                <ul class="harness-list" aria-label="Harnesses the installer connects">
                  {harnesses.map((h) => <li>{h}</li>)}
                </ul>
                <p class="owns-note">Also in the source tree, not yet in the installer: {inSource.join(', ')}.</p>
              </div>
              <div class="owns-join" aria-hidden="true"><span></span></div>
              <div class="owns-col owns-rivet">
                <p class="owns-label">RivetOS · this node</p>
                <p class="owns-what">Session identity, capture and memory, mesh, tasks, and the gateway HTTP + WS contract that Hub, desktop and Android all speak.</p>
                <p class="session-id"><span>session id</span><code>&lt;harness-id&gt;:&lt;native-session-id&gt;</code></p>
                <p class="owns-note">One canonical id everywhere — capture, hub, tasks, gateway. No dual key schemes.</p>
              </div>
            </div>
            <p class="chapter-foot">Runs where you put it: the local one-liner on Linux and macOS, Docker on a laptop, or LXC on Proxmox. <a href="/reference/architecture/">Architecture →</a></p>
          </div>
        </section>

        <section class="chapter" id="memory" aria-labelledby="memory-title">
          <div class="wrap">
            <header class="chapter-head">
              <span class="stud" aria-hidden="true"></span>
              <p class="chapter-no">02 · Memory</p>
              <h2 id="memory-title">Local-first memory. The record is yours.</h2>
              <p class="chapter-lede">
                The memory plane lives on the hub you run: PGlite on one machine, or Postgres on a datahub you
                enroll nodes into. Exposed over MCP, so any connected agent can search it before it answers.
              </p>
            </header>
            <div class="scrolly">
              <ol class="steps">
                <li class="step is-active" data-step="0">
                  <p class="step-tag">capture</p>
                  <h3>Every turn lands in the record.</h3>
                  <p>Prompts, tool calls and results are written as the session runs, keyed by the canonical session id. Nothing to remember to save.</p>
                </li>
                <li class="step" data-step="1">
                  <p class="step-tag">compact</p>
                  <h3>Long history folds into summaries.</h3>
                  <p>The compaction worker rolls messages up into leaf and branch summaries, so a month of work stays searchable without re-reading every transcript.</p>
                </li>
                <li class="step" data-step="2">
                  <p class="step-tag">recall</p>
                  <h3>Any agent asks; hybrid search answers.</h3>
                  <p>Full-text, trigram and vector search fused together, with hits that expand back to their source messages. Ask what you decided three weeks ago.</p>
                </li>
              </ol>
              <div class="stage">
                <div class="stage-term">
                  <div class="term-bar"><i></i><i></i><i></i><span>example output</span></div>
                  <pre class="panel is-active" data-panel="0"><code><span class="k">capture</span> claude-code:7f3a2c…
  <span class="ok">+</span> user        why does the mesh CA rotate?
  <span class="ok">+</span> tool_call   shell  rg -n "rotate" packages/
  <span class="ok">+</span> result      4 matches
  <span class="ok">+</span> assistant   Rotation runs through update --mesh…
<span class="dim">  → ros_messages  4 rows · embedding queued</span></code></pre>
                  <pre class="panel" data-panel="1"><code><span class="k">compaction-worker</span> 2026-06-12
  <span class="dim">leaf  </span>  42 msgs  → one root CA, per-node certs
  <span class="dim">leaf  </span>  31 msgs  → rotation via update --mesh
  <span class="dim">branch</span>  6 leaves → mesh trust model, week of 06-09
<span class="dim">  → summaries link back to their source messages</span></code></pre>
                  <pre class="panel" data-panel="2"><code><span class="k">rivet&gt;</span> memory_search "mesh CA decision?"
<span class="ok">●</span> 3 hits · hybrid fts+vector · 48ms
  1. <span class="dim">06-12</span> one root CA, per-node certs
  2. <span class="dim">06-13</span> rotation via update --mesh
  3. <span class="dim">06-27</span> roster fix deployed fleet-wide</code></pre>
                </div>
                <p class="stage-note">Illustrative output. <a href="/reference/memory-design/">Memory design →</a></p>
              </div>
            </div>
          </div>
        </section>


        <section class="chapter" id="mesh" aria-labelledby="mesh-title">
          <div class="wrap">
            <header class="chapter-head">
              <span class="stud" aria-hidden="true"></span>
              <p class="chapter-no">03 · Mesh</p>
              <h2 id="mesh-title">A mesh you enroll. Not one you join.</h2>
              <p class="chapter-lede">
                One machine is enough. When you want more, put a datahub on a server and enroll agent nodes
                into it. Every node shares one memory and can hand tasks to its peers. There is no
                Rivet-operated mesh.
              </p>
            </header>
            <div class="mesh-grid">
              <svg class="mesh-svg" viewBox="0 -24 560 384" role="img" aria-labelledby="mesh-svg-title mesh-svg-desc">
                <title id="mesh-svg-title">A datahub with three enrolled agent nodes</title>
                <desc id="mesh-svg-desc">Three agent nodes delegate tasks to each other over mTLS on port 3000. Each node reads and writes memory in the datahub's Postgres and enrolled over SSH, receiving its certificate and the mesh registry from the datahub.</desc>
                <g class="links">
                  <path class="peer" d="M170 78 L230 78" />
                  <path class="peer" d="M330 78 L390 78" />
                  <path class="peer" d="M110 50 C 180 0, 380 0, 450 50" />
                  <path class="hub" d="M110 106 C 110 190, 220 230, 250 262" />
                  <path class="hub" d="M280 106 L280 256" />
                  <path class="hub" d="M450 106 C 450 190, 340 230, 310 262" />
                </g>
                <g class="nodes">
                  <rect x="50" y="50" width="120" height="56" rx="10" />
                  <rect x="220" y="50" width="120" height="56" rx="10" />
                  <rect x="390" y="50" width="120" height="56" rx="10" />
                  <rect class="datahub" x="160" y="256" width="240" height="80" rx="12" />
                </g>
                <g class="labels">
                  <text x="110" y="75">node-a</text><text class="small" x="110" y="93">rivetos · :3000</text>
                  <text x="280" y="75">node-b</text><text class="small" x="280" y="93">rivetos · :3000</text>
                  <text x="450" y="75">node-c</text><text class="small" x="450" y="93">rivetos · :3000</text>
                  <text class="small peer-label" x="280" y="-8">delegation · mTLS · peer to peer</text>
                  <text x="280" y="283">datahub</text>
                  <text class="small" x="280" y="303">postgres + pgvector · memory</text>
                  <text class="small" x="280" y="321">CA · mesh.json · no agents</text>
                  <text class="small hub-label" x="290" y="146" text-anchor="start">memory (postgres)</text>
                  <text class="small hub-label" x="290" y="162" text-anchor="start">enrolled over ssh</text>
                </g>
              </svg>
              <dl class="mesh-facts">
                <div><dt>A datahub at the center</dt><dd>Postgres with pgvector, the memory schema, and the certificate authority. No agents run on it.</dd></div>
                <div><dt>Nodes enroll over SSH</dt><dd><code>node.sh --hub</code> runs the enrollment on the datahub. The node gets its certificate, the CA chain and <code>mesh.json</code> in one pass. The root CA key never leaves the datahub.</dd></div>
                <div><dt>Peers delegate over mTLS</dt><dd>A node finds its peers in <code>mesh.json</code> and hands them tasks on port 3000. Every connection is mutual TLS; there is no plaintext fallback.</dd></div>
              </dl>
            </div>
            <p class="chapter-foot"><a href="/guides/mesh/">Mesh networking →</a> · <a href="/guides/hub-setup/">Hub setup →</a> · <a href="/guides/mcp-auth/">MCP &amp; mesh auth →</a></p>
          </div>
        </section>

        <section class="chapter" id="plugins" aria-labelledby="plugins-title">
          <div class="wrap">
            <header class="chapter-head">
              <span class="stud" aria-hidden="true"></span>
              <p class="chapter-no">04 · Plugins</p>
              <h2 id="plugins-title">A small stable core. Everything else is a plugin.</h2>
              <p class="chapter-lede">
                Dependencies point inward: the core knows nothing about Anthropic or Postgres. Providers, tools,
                memory and transports adapt the outside world — cloud APIs or fully local models, your keys, your GPUs.
              </p>
            </header>
            <div class="tree" role="img" aria-label="The plugins directory: providers, tools, memory, transports, channels">
              <p class="tree-root">plugins/</p>
              {plugins.map((g) => (
                <div class="tree-group">
                  <p class="tree-dir">├─ {g.dir}/ <span>{g.items.length}</span></p>
                  <p class="tree-items">{g.items.map((i) => <span>{i}</span>)}</p>
                </div>
              ))}
            </div>
            <p class="chapter-foot"><a href="/guides/plugins/">Write a plugin →</a></p>
          </div>
        </section>
      </div>

      <section class="run" aria-labelledby="run-title">
        <div class="wrap">
          <p class="kicker">Three ways to run it</p>
          <h2 id="run-title">Start on your machine. Grow when you need to.</h2>
          <div class="run-grid">
            <a class="run-card" href={HUB} data-ph-event="cta_setup_agent">
              <span class="run-where">Laptop</span>
              <span class="run-what">RivetHub's local installer: hub and agents on one machine.</span>
              <span class="run-go">rivethub.io →</span>
            </a>
            <a class="run-card" href="/guides/hub-setup/">
              <span class="run-where">Datahub</span>
              <span class="run-what">Postgres on a server you own; enroll nodes over SSH.</span>
              <span class="run-go">Hub setup →</span>
            </a>
            <a class="run-card cloud" href={CLOUD}>
              <span class="run-where">Rivet Cloud</span>
              <span class="run-what">Hosted memory with export. Your agents still run on your machines.</span>
              <span class="run-go">Rivet Cloud →</span>
            </a>
          </div>
        </div>
      </section>

      <section class="docs" aria-labelledby="docs-title">
        <div class="wrap">
          <h2 id="docs-title">Read next</h2>
          <ul class="docs-grid">
            {guides.map((g) => (
              <li><a href={g.href}><span class="docs-title">{g.title}</span><span class="docs-text">{g.text}</span></a></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="wrap">
          <h2 id="closing-title">Start on your machine.<br /><em>Read the rest here.</em></h2>
          <div class="term install">
            <pre tabindex="0" data-copy="curl -fsSL https://get.rivethub.io/local.sh | bash"><code><span class="ps">$ </span>curl -fsSL https://get.rivethub.io/local.sh | bash</code></pre>
          </div>
          <div class="ctas">
            <a class="btn primary" href={HUB} data-ph-event="cta_setup_agent">Get RivetHub</a>
            <a class="btn" href="/guides/getting-started/">Getting started</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span>Apache 2.0 · <a href={GH}>philbert440/rivetOS</a></span>
        <nav aria-label="Footer">
          <a href={HUB}>RivetHub</a>
          <a href={CLOUD}>Rivet Cloud</a>
          <a href="/guides/introduction/">Docs</a>
          <a href="/reference/changelog/">Changelog</a>
          <a href="/privacy/">Privacy</a>
          <a href={GH}>GitHub</a>
        </nav>
      </div>
    </footer>

    <script>
      const root = document.documentElement
      root.classList.add('js')
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

      // Copy buttons on commands.
      document.querySelectorAll<HTMLPreElement>('pre[data-copy]').forEach((pre) => {
        const b = document.createElement('button')
        b.type = 'button'
        b.className = 'copy'
        b.textContent = 'copy'
        b.setAttribute('aria-label', 'Copy command')
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.dataset.copy || '')
            b.textContent = 'copied'
          } catch {
            const r = document.createRange()
            r.selectNodeContents(pre)
            const s = getSelection()
            s?.removeAllRanges()
            s?.addRange(r)
            b.textContent = 'select + copy'
          }
          setTimeout(() => (b.textContent = 'copy'), 2000)
        })
        pre.parentElement?.appendChild(b)
      })

      // Hero: one node, live.
      const canvas = document.getElementById('node-canvas') as HTMLCanvasElement | null
      if (canvas) {
        const ctx = canvas.getContext('2d')!
        const W = 640, H = 560
        const dpr = Math.min(devicePixelRatio || 1, 2)
        canvas.width = W * dpr
        canvas.height = H * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
        type P = { x: number; y: number }
        const c: Record<string, string> = {}
        const read = () => {
          const cs = getComputedStyle(root)
          for (const k of ['--accent', '--brass', '--rule', '--soft', '--faint', '--ink', '--surface', '--surface-2', '--wash'])
            c[k] = cs.getPropertyValue(k).trim()
        }
        const clients = [{ label: 'web', x: 150 }, { label: 'desktop', x: 320 }, { label: 'android', x: 490 }]
        const hs = ['claude-code', 'codex', 'grok-build', 'kimi-code', 'hermes']
        const hPos = hs.map((label, i) => ({ label, x: 72 + i * 124, y: 480 }))
        const node = { x: 240, y: 232, w: 250, h: 64 }
        const mem = { x: 540, y: 232 }
        const line = (a: P, b: P, n = 24): P[] => Array.from({ length: n + 1 }, (_, i) => ({ x: a.x + ((b.x - a.x) * i) / n, y: a.y + ((b.y - a.y) * i) / n }))
        const quad = (a: P, k: P, b: P, n = 28): P[] =>
          Array.from({ length: n + 1 }, (_, i) => {
            const t = i / n, u = 1 - t
            return { x: u * u * a.x + 2 * u * t * k.x + t * t * b.x, y: u * u * a.y + 2 * u * t * k.y + t * t * b.y }
          })
        const cToN = (ci: number) => line({ x: clients[ci].x, y: 78 }, { x: node.x + (clients[ci].x - 320) * 0.35, y: node.y - node.h / 2 })
        const nToH = (hi: number) => {
          const h = hPos[hi]
          const top = h.y - 15
          return quad({ x: node.x, y: node.y + node.h / 2 }, { x: node.x + (h.x - node.x) * 0.3, y: 380 }, { x: h.x, y: top })
        }
        const nToM = () => line({ x: node.x + node.w / 2, y: node.y }, { x: mem.x - 34, y: mem.y })
        const rev = (p: P[]) => p.slice().reverse()
        type Pk = { pts: P[]; t: number; v: number; kind: 'turn' | 'capture' | 'recall'; label: string; hi: number }
        const pk: Pk[] = []
        const n = { turns: 0, captured: 0, recalled: 0 }
        const flash = new Array(hs.length).fill(0)
        const spawn = (seed = false) => {
          const r = Math.random()
          const hi = Math.floor(Math.random() * hs.length)
          let p: Pk
          if (r < 0.4) p = { pts: [...cToN(Math.floor(Math.random() * 3)), ...nToH(hi)], t: 0, v: 0.004, kind: 'turn', label: 'turn', hi }
          else if (r < 0.75) p = { pts: [...rev(nToH(hi)), ...nToM()], t: 0, v: 0.005, kind: 'capture', label: ['tool_call', 'result', 'prompt'][Math.floor(Math.random() * 3)], hi }
          else p = { pts: [...rev(nToM()), ...nToH(hi)], t: 0, v: 0.006, kind: 'recall', label: 'memory_search', hi }
          if (seed) p.t = Math.random() * 0.9
          pk.push(p)
        }
        const at = (pts: P[], t: number): P => {
          const f = t * (pts.length - 1), i = Math.floor(f), a = pts[i], b = pts[Math.min(i + 1, pts.length - 1)]
          return { x: a.x + (b.x - a.x) * (f - i), y: a.y + (b.y - a.y) * (f - i) }
        }
        const rr = (x: number, y: number, w: number, h: number, r: number) => {
          ctx.beginPath()
          ctx.moveTo(x + r, y)
          ctx.arcTo(x + w, y, x + w, y + h, r)
          ctx.arcTo(x + w, y + h, x, y + h, r)
          ctx.arcTo(x, y + h, x, y, r)
          ctx.arcTo(x, y, x + w, y, r)
          ctx.closePath()
        }
        const stroke = (pts: P[]) => {
          ctx.beginPath()
          pts.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)))
          ctx.stroke()
        }
        const mono = (s: number, w = 400) => `${w} ${s}px "JetBrains Mono", ui-monospace, monospace`
        const draw = () => {
          ctx.clearRect(0, 0, W, H)
          ctx.lineWidth = 1.5
          ctx.strokeStyle = c['--rule']
          clients.forEach((_, i) => stroke(cToN(i)))
          hs.forEach((_, i) => stroke(nToH(i)))
          ctx.setLineDash([5, 5]); stroke(nToM()); ctx.setLineDash([])
          ctx.textAlign = 'center'
          ctx.textBaseline = 'middle'
          // tier labels
          ctx.fillStyle = c['--faint']
          ctx.font = mono(12)
          ctx.fillText('CLIENTS · same gateway contract', 320, 30)
          ctx.fillText('HARNESSES · wired by the installer', 320, 528)
          clients.forEach((cl) => {
            ctx.fillStyle = c['--surface']; ctx.strokeStyle = c['--rule']
            rr(cl.x - 50, 60, 100, 30, 15); ctx.fill(); ctx.stroke()
            ctx.fillStyle = c['--soft']; ctx.font = mono(14); ctx.fillText(cl.label, cl.x, 76)
          })
          ctx.fillStyle = c['--surface-2']; ctx.strokeStyle = c['--accent']; ctx.lineWidth = 2
          rr(node.x - node.w / 2, node.y - node.h / 2, node.w, node.h, 12); ctx.fill(); ctx.stroke()
          ctx.lineWidth = 1.5
          ctx.fillStyle = c['--ink']; ctx.font = '700 19px "DM Sans", system-ui, sans-serif'
          ctx.fillText('your node', node.x, node.y - 9)
          ctx.fillStyle = c['--faint']; ctx.font = mono(12)
          ctx.fillText('rivetos · gateway + capture', node.x, node.y + 13)
          // memory cylinder
          ctx.fillStyle = c['--wash']; ctx.strokeStyle = c['--accent']
          ctx.beginPath(); ctx.ellipse(mem.x, mem.y + 24, 32, 9, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke()
          ctx.fillRect(mem.x - 32, mem.y - 24, 64, 48)
          ctx.beginPath(); ctx.moveTo(mem.x - 32, mem.y - 24); ctx.lineTo(mem.x - 32, mem.y + 24); ctx.moveTo(mem.x + 32, mem.y - 24); ctx.lineTo(mem.x + 32, mem.y + 24); ctx.stroke()
          ctx.beginPath(); ctx.ellipse(mem.x, mem.y - 24, 32, 9, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke()
          ctx.fillStyle = c['--ink']; ctx.font = '700 14px "DM Sans", system-ui, sans-serif'
          ctx.fillText('memory', mem.x, mem.y + 5)
          ctx.fillStyle = c['--faint']; ctx.font = mono(12); ctx.fillText('pglite · postgres', mem.x, mem.y + 52)
          hPos.forEach((h, i) => {
            const lit = flash[i] > 0
            ctx.fillStyle = lit ? c['--wash'] : c['--surface']; ctx.strokeStyle = lit ? c['--brass'] : c['--rule']
            rr(h.x - 58, h.y - 15, 116, 30, 8); ctx.fill(); ctx.stroke()
            ctx.fillStyle = c['--soft']; ctx.font = mono(13); ctx.fillText(h.label, h.x, h.y + 1)
            if (flash[i] > 0) flash[i]--
          })
          ctx.textAlign = 'left'
          for (const p of pk) {
            const q = at(p.pts, p.t)
            const col = p.kind === 'recall' ? c['--brass'] : p.kind === 'capture' ? c['--accent'] : c['--soft']
            ctx.fillStyle = col
            ctx.beginPath(); ctx.arc(q.x, q.y, p.kind === 'turn' ? 3.5 : 4.5, 0, Math.PI * 2); ctx.fill()
            if (p.kind !== 'turn' && p.t > 0.1 && p.t < 0.6) {
              ctx.globalAlpha = Math.min(1, (0.6 - p.t) * 5)
              ctx.font = mono(12); ctx.fillText(p.label, q.x + 8, q.y - 8)
              ctx.globalAlpha = 1
            }
          }
        }
        const els = Object.fromEntries(['turns', 'captured', 'recalled'].map((k) => [k, document.querySelector(`[data-n="${k}"]`)]))
        const step = () => {
          for (let i = pk.length - 1; i >= 0; i--) {
            const p = pk[i]
            p.t += p.v
            if (p.t >= 1) {
              if (p.kind === 'turn') n.turns++
              else if (p.kind === 'capture') n.captured++
              else { n.recalled++; flash[p.hi] = 34 }
              pk.splice(i, 1)
            }
          }
          if (Math.random() < 0.06 && pk.length < 16) spawn()
          for (const k of Object.keys(n) as (keyof typeof n)[]) if (els[k]) els[k]!.textContent = n[k].toLocaleString()
        }
        read()
        for (let i = 0; i < 10; i++) spawn(true)
        draw()
        let raf = 0
        const loop = () => { step(); draw(); raf = requestAnimationFrame(loop) }
        if (!reduce) {
          new IntersectionObserver(([e]) => {
            cancelAnimationFrame(raf)
            if (e.isIntersecting) raf = requestAnimationFrame(loop)
          }).observe(canvas)
        }
        new MutationObserver(() => { read(); draw() }).observe(root, { attributes: true, attributeFilter: ['data-theme'] })
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { read(); draw() })
        document.fonts?.ready.then(draw)
      }

      // Memory steps drive the sticky terminal.
      const steps = [...document.querySelectorAll<HTMLElement>('.step')]
      const panels = [...document.querySelectorAll<HTMLElement>('.panel')]
      const activate = (i: number) => {
        steps.forEach((s, j) => s.classList.toggle('is-active', i === j))
        panels.forEach((p, j) => p.classList.toggle('is-active', i === j))
      }
      const so = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && activate(+(e.target as HTMLElement).dataset.step!)), { rootMargin: '-45% 0px -45% 0px' })
      steps.forEach((s) => so.observe(s))

      // Mesh draws itself once seen.
      const mesh = document.querySelector('.mesh-svg')
      if (mesh) new IntersectionObserver(([e], o) => { if (e.isIntersecting) { mesh.classList.add('is-drawn'); o.disconnect() } }, { threshold: 0.4 }).observe(mesh)

      // Scroll: header progress, spine fill, lit studs.
      const bar = document.querySelector<HTMLElement>('.progress')
      const story = document.querySelector<HTMLElement>('.story')
      const spine = document.querySelector<HTMLElement>('.spine')
      const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')]
      let ticking = false
      const onScroll = () => {
        ticking = false
        const vh = innerHeight
        const max = document.documentElement.scrollHeight - vh
        bar?.style.setProperty('--p', String(max > 0 ? scrollY / max : 0))
        if (story && spine) {
          const r = story.getBoundingClientRect()
          spine.style.setProperty('--fill', String(Math.min(1, Math.max(0, (vh * 0.55 - r.top) / r.height))))
        }
        chapters.forEach((ch) => {
          const stud = ch.querySelector('.stud')
          if (stud) ch.classList.toggle('is-lit', stud.getBoundingClientRect().top < vh * 0.55)
        })
      }
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll) } }, { passive: true })
      addEventListener('resize', onScroll)
      onScroll()
    </script>
  </body>
</html>

<style is:global>
  :root {
