      --bg: #0f1311; --surface: #151a16; --surface-2: #1b221c; --ink: #e8ede5; --soft: #a0af9d; --faint: #6d7b6b;
      --rule: #25302a; --grid: rgba(255, 255, 255, 0.035); --accent: #34d399; --accent-hi: #6ee7b7; --on-accent: #08130d;
      --wash: #12382a; --brass: #d9b36b; --sky: #8cc8ea; --term-bg: #0a0f0c; --term-dim: #78897a;
      --shadow: 0 1px 0 rgba(0, 0, 0, 0.2), 0 24px 50px -26px rgba(0, 0, 0, 0.7);
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0f1311; --surface: #151a16; --surface-2: #1b221c; --ink: #e8ede5; --soft: #a0af9d; --faint: #6d7b6b;
    --rule: #25302a; --grid: rgba(255, 255, 255, 0.035); --accent: #34d399; --accent-hi: #6ee7b7; --on-accent: #08130d;
    --wash: #12382a; --brass: #d9b36b; --sky: #8cc8ea; --term-bg: #0a0f0c; --term-dim: #78897a;
    --shadow: 0 1px 0 rgba(0, 0, 0, 0.2), 0 24px 50px -26px rgba(0, 0, 0, 0.7);
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body {
    margin: 0;
    background-color: var(--bg);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
    color: var(--ink);
    font: 400 17px/1.6 var(--font-sans);
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  ::selection { background: color-mix(in srgb, var(--accent) 30%, transparent); }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--accent); text-underline-offset: 3px; text-decoration: none; }
  a:hover { color: var(--accent-hi); text-decoration: underline; }
  p, h1, h2, h3, figure, dl, dd, ul, ol { margin: 0; }
  h1, h2, h3 { text-wrap: balance; letter-spacing: -0.03em; line-height: 1.05; }
  code { font-family: var(--font-mono); font-size: 0.86em; background: var(--surface-2); padding: 0.08em 0.35em; border-radius: 4px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding-inline: var(--gutter); }
  .skip { position: absolute; left: -999px; top: 8px; z-index: 50; background: var(--ink); color: var(--bg); padding: 8px 14px; }
  .skip:focus { left: 16px; }

  .kicker, .chapter-no, .step-tag, .owns-label, .run-where, .tree-root, .tree-dir, .term-bar span {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .kicker { color: var(--soft); display: flex; align-items: center; gap: 10px; }

  /* Header */
  .top {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; }
  .brand:hover { color: var(--ink); text-decoration: none; }
  .brand img { width: 24px; object-fit: contain; image-rendering: pixelated; }
  .top-nav { display: flex; align-items: center; gap: 22px; font-size: 15px; }
  .top-nav a { color: var(--soft); }
  .top-nav a:hover { color: var(--ink); text-decoration: none; }
  .top-nav .top-cta { color: var(--on-accent); background: var(--accent); padding: 7px 14px; border-radius: 999px; font-weight: 500; }
  .top-nav .top-cta:hover { color: var(--on-accent); background: var(--accent-hi); }
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; }
  .progress i { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(var(--p, 0)); }
  @media (max-width: 860px) { .top-nav a:not(.top-cta) { display: none; } }

  /* Buttons + terminals */
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .btn { display: inline-flex; align-items: center; padding: 11px 20px; border-radius: 999px; border: 1px solid var(--rule); background: var(--surface); color: var(--ink); font-weight: 500; transition: transform 0.15s, border-color 0.15s, background 0.15s; }
  .btn:hover { color: var(--ink); border-color: var(--soft); transform: translateY(-1px); text-decoration: none; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .btn.primary:hover { background: var(--accent-hi); border-color: var(--accent-hi); color: var(--on-accent); }
  .btn.ghost { background: transparent; }
  .term { position: relative; background: var(--term-bg); color: var(--term-ink); border-radius: 12px; overflow: hidden; }
  .term pre { margin: 0; padding: 13px 84px 13px 16px; overflow-x: auto; font: 14px/1.6 var(--font-mono); }
  .term code { background: none; padding: 0; font-size: inherit; color: inherit; }
  .ps { color: var(--term-dim); user-select: none; }
  .copy { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font: 12px var(--font-mono); color: var(--term-ink); background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 6px; padding: 4px 9px; cursor: pointer; }
  .copy:hover { background: rgba(255, 255, 255, 0.16); }

  /* Hero */
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(56px, 8vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--wash); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px transparent; } }
  .hero h1 { margin-top: 20px; font-size: clamp(2.5rem, 4.6vw, 4.2rem); font-weight: 700; letter-spacing: -0.045em; line-height: 0.98; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .lede { margin-top: 22px; max-width: 54ch; color: var(--soft); font-size: clamp(17px, 1.5vw, 19px); }
  .hero .install { margin-top: 28px; max-width: 520px; }
  .hero .ctas { margin-top: 20px; }
  .fine { margin-top: 18px; color: var(--faint); font-size: 14px; max-width: 58ch; }
  .hero-viz { position: relative; }
  .hero-viz canvas { display: block; width: 100%; height: auto; aspect-ratio: 640 / 560; max-width: 100%; border-radius: 20px; background: var(--surface); border: 1px solid var(--rule); box-shadow: var(--shadow); }
  .readout { position: absolute; left: 16px; bottom: calc(100% - 36px); display: none; }
  .hero-viz figcaption { margin-top: 12px; font-size: 14px; color: var(--faint); }
  .hero-viz .readout { position: static; display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 12px; font: 12px var(--font-mono); color: var(--soft); font-variant-numeric: tabular-nums; }
  .readout b { color: var(--ink); }

  /* Story + spine */
  .story { position: relative; border-top: 1px solid var(--rule); }
  .spine { position: absolute; top: 0; bottom: 0; left: max(calc((100% - var(--wrap)) / 2 + var(--gutter) + var(--spine-x)), calc(var(--gutter) + var(--spine-x))); width: 2px; background: var(--rule); }
  .spine i { position: absolute; inset: 0; background: linear-gradient(var(--accent), var(--accent) 70%, var(--brass)); transform-origin: top; transform: scaleY(var(--fill, 0)); }
  .chapter { padding-block: clamp(72px, 10vw, 128px) 0; }
  .chapter > .wrap { padding-left: calc(var(--gutter) + var(--spine-x) + var(--indent)); }
  .chapter-head { position: relative; max-width: 800px; }
  .stud { position: absolute; top: 2px; left: calc(-1 * var(--indent) - 8px); width: 18px; height: 18px; border-radius: 50%; background: var(--bg); border: 2px solid var(--rule); transition: background 0.4s, border-color 0.4s, box-shadow 0.4s; }
  .chapter.is-lit .stud { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 6px var(--wash); }
  .chapter-no { color: var(--accent); }
  .chapter-head h2 { margin-top: 12px; font-size: clamp(2rem, 4.4vw, 3.6rem); font-weight: 700; letter-spacing: -0.04em; }
  .chapter-lede { margin-top: 18px; color: var(--soft); font-size: clamp(17px, 1.5vw, 19px); max-width: 62ch; }
  .chapter-foot { margin-top: 28px; color: var(--soft); font-size: 15px; }

  /* 01 owns */
  .owns { margin-top: clamp(36px, 5vw, 56px); display: grid; grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr); align-items: stretch; }
  .owns-col { padding: clamp(22px, 3vw, 30px); background: var(--surface); border: 1px solid var(--rule); border-radius: 16px; display: grid; gap: 14px; align-content: start; }
  .owns-rivet { border-color: var(--accent); }
  .owns-label { color: var(--faint); }
  .owns-rivet .owns-label { color: var(--accent); }
  .owns-what { font-size: 18px; letter-spacing: -0.01em; }
  .owns-join { display: grid; place-items: center; }
  .owns-join span { width: 100%; height: 2px; background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 11px); }
  .harness-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .harness-list li { font: 12.5px var(--font-mono); padding: 4px 10px; border-radius: 6px; background: var(--surface-2); color: var(--soft); }
  .session-id { display: grid; gap: 6px; }
  .session-id span { font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--faint); }
  .session-id code { font-size: 14px; justify-self: start; }
