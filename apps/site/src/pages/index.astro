  .step h3 { margin-top: 10px; font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 700; }
  .step p:last-child { margin-top: 12px; color: var(--soft); max-width: 46ch; }
  .stage { position: sticky; top: 100px; align-self: start; }
  .stage-term { background: var(--term-bg); color: var(--term-ink); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); min-height: 240px; display: grid; }
  .stage-term .term-bar { display: flex; align-items: center; gap: 6px; padding: 11px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
  .stage-term .term-bar i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.18); }
  .stage-term .term-bar span { margin-left: auto; color: var(--term-dim); font-size: 10.5px; }
  .panel { grid-area: 2 / 1; margin: 0; padding: 18px 20px 22px; font: 13.5px/1.75 var(--font-mono); overflow-x: auto; opacity: 0; transform: translateY(6px); transition: opacity 0.4s, transform 0.4s; }
  .panel.is-active { opacity: 1; transform: none; }
  .panel code { background: none; padding: 0; font-size: inherit; color: inherit; }
  .panel .k { color: #6ee7b7; }
  .panel .ok { color: #34d399; }
  .panel .dim { color: var(--term-dim); }
  .stage-note { margin-top: 10px; font-size: 13px; color: var(--faint); }
  :root:not(.js) .panel { opacity: 1; transform: none; grid-area: auto; }
  :root:not(.js) .step { opacity: 1; }

  /* 04 mesh */
  .mesh-grid { margin-top: clamp(36px, 5vw, 56px); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 5vw, 56px); align-items: center; }
  .mesh-svg { width: 100%; height: auto; max-width: 100%; }
  .mesh-svg .links path { fill: none; stroke-width: 2; }
  .mesh-svg .links .peer { stroke: var(--accent); stroke-dasharray: 6 7; }
  .mesh-svg .links .hub { stroke: var(--brass); stroke-opacity: 0.8; }
  .mesh-svg .nodes rect { fill: var(--surface); stroke: var(--accent); stroke-width: 2; }
  .mesh-svg .nodes .datahub { stroke: var(--brass); fill: var(--surface-2); }
  .mesh-svg text { fill: var(--ink); font: 600 14px var(--font-mono); text-anchor: middle; }
  .mesh-svg text.small { fill: var(--faint); font-size: 11px; font-weight: 400; }
  .mesh-svg text.peer-label { fill: var(--accent); }
  .mesh-svg text.hub-label { fill: var(--brass); text-anchor: start; }
  .js .mesh-svg .links .peer { animation: march 1.4s linear infinite; animation-play-state: paused; }
  .js .mesh-svg.is-drawn .links .peer { animation-play-state: running; }
  @keyframes march { to { stroke-dashoffset: -26; } }
  .mesh-facts { display: grid; gap: 20px; }
  .mesh-facts dt { font-weight: 700; font-size: 18px; letter-spacing: -0.02em; }
  .mesh-facts dd { margin-top: 4px; color: var(--soft); font-size: 15px; }

  /* 05 plugins tree */
  .tree { margin-top: clamp(36px, 5vw, 56px); padding: clamp(20px, 3vw, 30px); background: var(--term-bg); color: var(--term-ink); border-radius: 16px; display: grid; gap: 14px; overflow-x: auto; }
  .tree-root { color: #6ee7b7; }
  .tree-group { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 8px 16px; align-items: baseline; }
  .tree-dir { color: var(--term-ink); text-transform: none; letter-spacing: 0; font-size: 13.5px; }
  .tree-dir span { color: var(--term-dim); margin-left: 6px; }
  .tree-items { display: flex; flex-wrap: wrap; gap: 6px; }
