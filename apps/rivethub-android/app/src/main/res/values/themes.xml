<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paper window (classic light bg, #F6F4EE) so the cold start matches the
         Compose light scheme instead of flashing white. -->
    <style name="Theme.RivetBots" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F6F4EE</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
