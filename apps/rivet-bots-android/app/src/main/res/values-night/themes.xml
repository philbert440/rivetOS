<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night: charcoal window so the cold start matches the Compose dark scheme,
         and status/navigation bars take light (non-light-bar) icons. -->
    <style name="Theme.RivetBots" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D1117</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
