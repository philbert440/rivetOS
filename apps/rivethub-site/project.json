{
  "name": "rivethub-site",
  "root": "apps/rivethub-site",
  "sourceRoot": "apps/rivethub-site/public",
  "projectType": "application",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "command": "node apps/rivethub-site/scripts/build.mjs",
      "inputs": [
        "{projectRoot}/public/**/*",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/apps/public-sites/family.mjs",
        "{workspaceRoot}/apps/public-sites/chrome.mjs",
        "{workspaceRoot}/apps/public-sites/html.mjs",
        "{workspaceRoot}/apps/public-sites/family.css",
        "{projectRoot}/.env*",
        { "env": "PUBLIC_POSTHOG_KEY" },
        { "env": "PUBLIC_POSTHOG_HOST" },
        { "env": "NEXT_PUBLIC_POSTHOG_KEY" },
        { "env": "NEXT_PUBLIC_POSTHOG_HOST" },
        {
          "runtime": "node apps/rivethub-site/scripts/posthog-cache-key.mjs apps/rivethub-site hub"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "command": "node --test apps/rivethub-site/scripts/*.test.mjs",
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/public/**/*",
        "{workspaceRoot}/apps/public-sites/**/*",
        "{workspaceRoot}/apps/site/src/components/PostHog.astro"
      ]
    }
  }
}
