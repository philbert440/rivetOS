{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rivet-team",
  "version": "0.1.0",
  "identifier": "dev.rivetos.rivetteam",
  "build": {
    "frontendDist": "../../rivet-team-web/dist",
    "devUrl": "http://127.0.0.1:5180"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rivet-team",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self' http: https: ws: wss:; frame-src http: https:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
