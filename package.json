{
  "name": "rivetos",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Lightweight, stable agent runtime. Zero bloat. Zero lock-in. Just the loop.",
  "license": "Apache-2.0",
  "author": "Philip Tompkins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbert440/rivetOS.git"
  },
  "keywords": [
    "ai",
    "agent",
    "runtime",
    "llm",
    "typescript",
    "open-source",
    "claude",
    "grok",
    "gemini",
    "ollama"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "axios": "^1.19.0",
    "tar": "^7.5.22",
    "form-data": "^4.0.6",
    "tmp": "^0.2.7",
    "postcss": "^8.5.25",
    "svgo": "^4.0.2",
    "sharp": "^0.35.3",
    "ip-address": "^10.4.0",
    "fast-uri": "^3.1.5",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^5": "5.0.9",
    "undici@^6": "6.28.0",
    "undici@^8": "8.10.0",
    "undici@<=6.26.0": "6.28.0",
    "follow-redirects": "^1.16.0",
    "nx": {
      "brace-expansion": "^5.0.9",
      "follow-redirects": "^1.16.0",
      "yaml": "^2.9.0"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/den",
    "apps/site",
    "apps/rivethub-web",
    "apps/rivet-android",
    "apps/rivet-bots-android",
    "plugins/channels/*",
    "plugins/memory/*",
    "plugins/providers/*",
    "plugins/tools/*",
    "plugins/transports/*",
    "services/*",
    "integrations/grok/rivet-memory/capture",
    "integrations/kimi/rivet-memory/capture",
    "integrations/kimi/rivet-den",
    "integrations/kimi/rivet-memory/backfill"
  ],
  "bin": {
    "rivetos": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "postinstall": "npm run build && npm run link-cli",
    "link-cli": "node scripts/link-cli.mjs",
    "build": "nx run-many -t build --exclude container-rivetos,site",
    "bundle": "node scripts/bundle.mjs",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "ci": "nx run-many -t lint typecheck build test --exclude container-rivetos",
    "ci:affected": "nx affected -t lint typecheck build test --exclude container-rivetos",
    "dev": "tsx packages/cli/src/index.ts start",
    "cli": "tsx packages/cli/src/index.ts",
    "graph": "nx graph",
    "containers:build": "nx run container-rivetos:build",
    "compose:up": "docker compose -f infra/docker/rivetos/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/rivetos/docker-compose.yml down",
    "clean": "find packages plugins -path '*/src/*.d.ts' -delete && find packages plugins -path '*/src/*.d.ts.map' -delete && echo 'Cleaned build artifacts from src/'",
    "lint:boundaries": "node scripts/boundary-probe.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs --tracked"
  },
  "bugs": {
    "url": "https://github.com/philbert440/rivetOS/issues"
  },
  "homepage": "https://rivetos.dev",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint-plugin": "^22.7.8",
    "@nx/js": "22.7.8",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nx": "22.7.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
