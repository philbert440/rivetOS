{
  "name": "@rivetos/provider-codex-cli",
  "version": "0.5.0",
  "description": "Codex CLI provider — runs codex exec using the user's existing ChatGPT login and preserves one Codex thread per RivetOS conversation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ package.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.10",
    "@rivetos/aisdk": "0.5.0",
    "@rivetos/types": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^5.0.0"
  },
  "rivetos": {
    "type": "provider",
    "name": "codex-cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbert440/rivetOS.git",
    "directory": "plugins/providers/codex-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "tags": [
      "scope:adapter",
      "type:plugin",
      "domain:runtime"
    ]
  }
}
