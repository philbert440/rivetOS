{
  "name": "@rivetos/provider-claude-cli",
  "version": "0.5.0",
  "description": "Claude Code CLI provider \u2014 shells out to the local `claude` binary, using the user's subscription OAuth token. Sanctioned pattern per Anthropic's April 2026 third-party harness policy.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rivetos-claude-capture": "dist/hooks.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ package.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@rivetos/aisdk": "0.5.0",
    "@rivetos/types": "0.5.0",
    "pg": "^8.22.0",
    "@rivetos/mcp-v2": "0.5.0",
    "@rivetos/mcp": "0.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "vitest": "^4.1.10"
  },
  "rivetos": {
    "type": "provider",
    "name": "claude-cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbert440/rivetOS.git",
    "directory": "plugins/providers/claude-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "tags": [
      "scope:transport",
      "type:plugin",
      "domain:runtime"
    ]
  }
}
