{
  "name": "@rivetos/memory-sqlite",
  "version": "0.5.0",
  "description": "RivetOS Memory System — SQLite backend (WAL + FTS5) for the in-process Memory contract",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ package.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rivetos/memory-core": "0.5.0",
    "@rivetos/token-command": "0.5.0",
    "@rivetos/types": "0.5.0"
  },
  "rivetos": {
    "type": "memory",
    "name": "sqlite"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbert440/rivetOS.git",
    "directory": "plugins/memory/sqlite"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "nx": {
    "tags": [
      "scope:adapter",
      "type:plugin",
      "domain:memory"
    ]
  }
}
